---
<div class="card clock">
  <h3>Time in Kerala</h3>
  <p class="ist" aria-live="off"><strong id="ist-time">--:--</strong> <span class="muted">IST (UTC+5:30)</span></p>
  <p class="small muted" id="ist-diff">India has no daylight saving.</p>
</div>
<style>.ist { font-size: 1.6rem; margin: 0 0 4px; } .ist .muted { font-size: .9rem; }</style>
<script>
  const t = document.getElementById('ist-time');
  const diff = document.getElementById('ist-diff');
  const tick = () => {
    const now = new Date();
    if (t) t.textContent = now.toLocaleTimeString('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit' });
    const localOffset = -now.getTimezoneOffset();
    const d = 330 - localOffset;
    if (diff) {
      if (d === 0) diff.textContent = 'You are on the same time as Kerala.';
      else {
        const h = Math.floor(Math.abs(d) / 60), m = Math.abs(d) % 60;
        diff.textContent = `Kerala is ${h} h${m ? ` ${m} min` : ''} ${d > 0 ? 'ahead of' : 'behind'} you. India has no daylight saving.`;
      }
    }
  };
  tick(); setInterval(tick, 30000);
</script>
