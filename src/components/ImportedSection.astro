---
// Shows entries this visitor imported on the Contribute page. Filled in the browser; hidden when empty.
interface Props { type: string }
const { type } = Astro.props;
---
<section class="imported-section" data-type={type} hidden>
  <h2>Imported by you</h2>
  <p class="small muted">Only you can see these: they are stored in this browser. Manage them on the <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/contribute`}>Contribute</a> page.</p>
  <div class="grid three imp-grid"></div>
</section>
<script>
  import { listImported } from '../lib/community.js';
  import { cardHtml } from '../lib/render.js';
  document.querySelectorAll<HTMLElement>('.imported-section').forEach((s) => {
    const items = listImported(s.dataset.type!);
    if (!items.length) return;
    s.querySelector('.imp-grid')!.innerHTML = items.map((e: object) => cardHtml(s.dataset.type!, e)).join('');
    s.hidden = false;
  });
</script>
