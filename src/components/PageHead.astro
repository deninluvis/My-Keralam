---
import meta from '../data/meta.json';
interface Props { eyebrow?: string; title: string; lead?: string; verified?: boolean }
const { eyebrow, title, lead, verified = false } = Astro.props;
const d = new Date(meta.lastVerified).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<header class="page-head wrap">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  {verified && <p class="verified">Last verified {d}. Rules change, so check the official links.</p>}
  <slot />
</header>
