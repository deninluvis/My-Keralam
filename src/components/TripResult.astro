---

import Icon from './Icon.astro';
import { url } from '../lib/url.js';

interface Props { festivals: unknown[]; destinations: { slug: string; name: string; lat: number; lng: number; base?: string | null }[] }
const { festivals, destinations } = Astro.props;
---
    <article id="trip" hidden>
      <header class="page-head trip-head">
        <p class="eyebrow">Your plan</p>
        <h1 id="t-title">Your Keralam trip</h1>
        <p class="lead" id="t-sub"></p>
        <div class="btn-row no-print">
          <button class="btn small" id="print" type="button"><Icon name="print" />Print</button>
          <button class="btn small ghost" id="share" type="button"><Icon name="share" />Share link</button>
          <button class="btn small ghost" id="edit" type="button">Edit answers</button>
          <span id="gmaps" class="gmaps"></span>
        </div>
        <p class="small muted" id="share-msg" aria-live="polite"></p>
        <form class="save-row no-print" id="save-form">
          <div class="field"><label for="trip-name">Trip name</label><input id="trip-name" maxlength="60" placeholder="e.g. Honeymoon, December 2026" /></div>
          <button class="btn small" type="submit">Save trip</button>
        </form>
        <p class="small muted no-print">Saved only in this browser on this device. Clearing your browser data deletes it.</p>
        <p class="small" id="save-msg" aria-live="polite"></p>
      </header>

      <div id="warnings"></div>

      <div class="tabs no-print" role="tablist" aria-label="Trip sections">
        <button role="tab" aria-selected="true" aria-controls="p-itin" id="tab-itin">Itinerary</button>
        <button role="tab" aria-selected="false" aria-controls="p-budget" id="tab-budget">Budget</button>
        <button role="tab" aria-selected="false" aria-controls="p-visa" id="tab-visa">Visa</button>
        <button role="tab" aria-selected="false" aria-controls="p-check" id="tab-check">Checklist</button>
      </div>

      <section role="tabpanel" id="p-itin" aria-labelledby="tab-itin">
        <div class="itin-grid">
          <ol class="days" id="days"></ol>
          <div>
            <div id="route-map" class="map" role="img" aria-label="Map of your route"></div>
            <p class="small" style="margin:8px 0 0"><span id="gmaps-2"></span> <span class="muted">Driving directions through every place on the map. Google Maps takes up to 11 places per link, so longer trips come in parts.</span></p>
            <div class="card" style="margin-top:16px">
              <h3>Festivals during your trip</h3>
              <ul id="fests" class="small"></ul>
              <a class="small" href={url('/festivals')}>Festival calendar →</a>
            </div>
          </div>
        </div>
      </section>

      <section role="tabpanel" id="p-budget" aria-labelledby="tab-budget" hidden>
        <div class="card">
          <h2 style="margin-top:0">Budget estimate</h2>
          <p class="big" id="b-total"></p>
          <p class="muted" id="b-conv"></p>
          <div class="table-wrap"><table><tbody id="b-parts"></tbody></table></div>
          <p class="small muted" style="margin-top:12px" id="b-ex"></p>
          <p class="small muted">These are rough estimates for planning, based on typical prices. Peak-season and holiday prices (Christmas–New Year, Onam) can be much higher.</p>
        </div>
      </section>

      <section role="tabpanel" id="p-visa" aria-labelledby="tab-visa" hidden>
        <div class="card" id="visa-box"></div>
        <p style="margin-top:12px"><a href={url('/before-you-go')}>Step-by-step e-Visa guide →</a></p>
      </section>

      <section role="tabpanel" id="p-check" aria-labelledby="tab-check" hidden>
        <div class="grid two">
          <div class="card"><h3>Before you fly</h3><ul class="checklist" id="pre"></ul></div>
          <div class="card"><h3>Packing list</h3><ul class="checklist" id="pack"></ul></div>
        </div>
      </section>
    </article>
    <script type="application/json" id="fest-data" set:html={JSON.stringify(festivals)}></script>
    <script type="application/json" id="dest-data" set:html={JSON.stringify(destinations)}></script>

<style>
  .gmaps { display: contents; }
  .save-row { display: flex; gap: 10px; align-items: end; flex-wrap: wrap; margin-top: 12px; }
  .save-row .field { margin: 0; flex: 1 1 220px; }
  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin: 20px 0 16px; overflow-x: auto; }
  .tabs button { font: inherit; font-weight: 600; background: none; border: 0; padding: 12px 16px; color: var(--muted); cursor: pointer; border-bottom: 3px solid transparent; white-space: nowrap; }
  .tabs button[aria-selected='true'] { color: var(--green); border-color: var(--green); }
  .itin-grid { display: grid; gap: 16px; }
  @media (min-width: 900px) { .itin-grid { grid-template-columns: 1.4fr 1fr; align-items: start; } }
  .days { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .map { height: 320px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface-2); z-index: 0; }
  .big { font-size: 1.8rem; font-weight: 700; margin: 0; }
  #warnings :global(.callout) { margin: 8px 0; }
  @media print { [role='tabpanel'] { display: block !important; } .map { display: none; } }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { buildTrip, decodeInput, encodeInput, tripPlaces, mapsLinks } from '../lib/planner.js';
  import { listImported } from '../lib/community.js';
  import { listTrips, saveTrip } from '../lib/trips.js';
  import bases from '../data/bases.json';
  import journeys from '../data/journeys.json';
  import months from '../data/months.json';
  const festivals = JSON.parse(document.getElementById('fest-data')!.textContent!);
  const destinations = [...JSON.parse(document.getElementById('dest-data')!.textContent!), ...listImported('destination')];
  import visa from '../data/visa.json';
  import seasons from '../data/seasons.json';
  import meta from '../data/meta.json';
  const data = { bases, journeys, months, festivals, visa, seasons };

  const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const $ = (id: string) => document.getElementById(id)!;
  const inr = (n: number) => `₹${Math.round(n).toLocaleString('en-IN')}`;

  // The trip comes from the URL; `tid` (when present) is the id of the saved trip it was opened from.
  const params = new URLSearchParams(location.search);
  let tid = params.get('tid');
  params.delete('tid');
  const query = params.toString();

  if (query) {
    const trip = buildTrip(decodeInput(query), data);
    const places = tripPlaces(trip, destinations);
    const shareQuery = encodeInput(trip.input);
    render(trip, places);
    const links = mapsLinks(places);
    const linkHtml = (cls: string) => links.map((u, i) => `<a class="${cls}" href="${esc(u)}" target="_blank" rel="noopener">${links.length > 1 ? `Google Maps route, part ${i + 1}` : 'Open route in Google Maps'}</a>`).join(' ');
    $('gmaps').innerHTML = linkHtml('btn small ghost');
    $('gmaps-2').innerHTML = linkHtml('');
    setupTabs();
    const nameInput = $('trip-name') as HTMLInputElement;
    const savedTrip = tid ? listTrips().find((t) => t.id === tid) : undefined;
    if (savedTrip) nameInput.value = savedTrip.name; else tid = null;
    $('save-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const r = saveTrip({ id: tid || undefined, name: nameInput.value, query: shareQuery });
      $('save-msg').textContent = r.ok ? `Saved as "${r.trip!.name}".` : r.error!;
      if (r.ok) {
        tid = r.trip!.id;
        nameInput.value = r.trip!.name;
        history.replaceState(null, '', `${location.pathname}?${shareQuery}&tid=${encodeURIComponent(tid)}`);
        document.dispatchEvent(new CustomEvent('trips-changed'));
      }
    });
    $('print').addEventListener('click', () => window.print());
    $('share').addEventListener('click', async () => {
      const link = `${location.origin}${location.pathname}?${shareQuery}`;
      try {
        if (navigator.share) await navigator.share({ title: 'My Kerala trip', url: link });
        else { await navigator.clipboard.writeText(link); $('share-msg').textContent = 'Link copied. Anyone with it sees the same plan.'; }
      } catch (e) { $('share-msg').textContent = link; }
    });
  }

  function fmtDate(iso: string, opts: Intl.DateTimeFormatOptions = { weekday: 'short', day: 'numeric', month: 'short' }) {
    return new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { ...opts, timeZone: 'UTC' });
  }

  function render(t: ReturnType<typeof buildTrip>, places: ReturnType<typeof tripPlaces>) {
    $('trip').hidden = false;
    $('t-title').textContent = `Your ${t.input.days}-day Keralam trip`;
    $('t-sub').textContent = `${fmtDate(t.input.start, { day: 'numeric', month: 'short', year: 'numeric' })} – ${fmtDate(t.end, { day: 'numeric', month: 'short', year: 'numeric' })} · ${t.input.people} traveller${t.input.people > 1 ? 's' : ''} · ${t.input.budget === 'mid' ? 'mid-range' : t.input.budget} · ${t.season.label}`;

    $('warnings').innerHTML = t.warnings.map((w) => `<div class="callout">${esc(w)}</div>`).join('');

    $('days').innerHTML = t.days.map((d) => `
      <li class="card">
        <div class="meta"><strong>Day ${d.n}</strong><span>${esc(fmtDate(d.date))}</span><span class="tag">${esc(d.base)}</span></div>
        ${d.lines.map((l, i) => `<p class="${i === 0 && d.travel ? 'small muted' : ''}">${esc(l)}</p>`).join('')}
      </li>`).join('');

    $('fests').innerHTML = t.festivals.length
      ? t.festivals.map((f) => `<li><strong>${esc(f.name)}</strong>: ${esc(f.where)}</li>`).join('')
      : '<li>No major festivals in these months. Local temple and church festivals happen all year.</li>';

    // Budget
    let cur = 'USD';
    try { const c = localStorage.getItem('currency'); if (c && (meta.rates as any)[c]) cur = c; } catch (e) {}
    const rate = (meta.rates as any)[cur];
    const fx = (n: number) => (n / rate).toLocaleString(undefined, { style: 'currency', currency: cur, maximumFractionDigits: 0 });
    $('b-total').textContent = `${inr(t.budget.low)} – ${inr(t.budget.high)}`;
    $('b-conv').textContent = `About ${fx(t.budget.low)} – ${fx(t.budget.high)} for ${t.input.people} traveller${t.input.people > 1 ? 's' : ''}. ${meta.ratesNote}`;
    const p = t.budget.parts;
    const rows: [string, number][] = [['Rooms, food, local transport and sightseeing', p.daily], ['Transfers between stops', p.transport], ['Houseboat night', p.houseboat], ['Ayurveda treatments', p.ayurveda]];
    $('b-parts').innerHTML = rows.filter(([, v]) => v > 0).map(([k, v]) => `<tr><td>${esc(k)}</td><td>${inr(v)}</td><td class="muted">${esc(fx(v))}</td></tr>`).join('');
    $('b-ex').textContent = `Not included: ${t.budget.excludes}`;

    // Visa
    const v = t.visa;
    $('visa-box').innerHTML = v.eligible
      ? `<h2 style="margin-top:0">Recommended: ${esc(v.recommended.name)}</h2>
         <p>${esc(v.recommended.validity)} · ${esc(v.recommended.entries)} · ${esc(v.recommended.fee)}</p>
         ${v.voa ? `<div class="callout ok">${esc(v.nat.name)} passport holders can also get a visa on arrival at major airports. ${esc(v.voaNote || '')}</div>` : ''}
         <ul>${v.notes.map((n) => `<li>${esc(n)}</li>`).join('')}</ul>
         <p class="small muted">Typical fees; your nationality may pay a different amount. <a href="${esc(visa.feeTable)}" rel="noopener">Official fee table</a>.</p>`
      : `<h2 style="margin-top:0">e-Visa not available</h2><div class="callout danger">${esc(v.notes[0])}</div>`;

    // Checklists (state remembered per item)
    const pre = ['Passport valid for at least 6 months, with 2 blank pages', v.eligible ? `Apply for ${v.recommended.name} on the official portal` : 'Apply for a regular visa at the Indian mission', 'Fill in the free e-Arrival Card online', 'Buy travel insurance that covers medical evacuation', 'Ask a travel clinic about vaccinations and malaria/dengue advice', 'Book houseboats, park visits and peak-season rooms', 'Tell your bank you are travelling; carry two cards', 'Save the emergency numbers (112, 1363) and this plan offline'];
    const list = (id: string, items: string[]) => {
      $(id).innerHTML = items.map((it, i) => {
        const key = `chk:${id}:${it}`;
        let on = false; try { on = localStorage.getItem(key) === '1'; } catch (e) {}
        return `<li><label><input type="checkbox" data-key="${esc(key)}" ${on ? 'checked' : ''}/> <span>${esc(it)}</span></label></li>`;
      }).join('');
    };
    list('pre', pre);
    list('pack', t.packing);
    document.querySelectorAll<HTMLInputElement>('.checklist input').forEach((c) => c.addEventListener('change', () => {
      try { c.checked ? localStorage.setItem(c.dataset.key!, '1') : localStorage.removeItem(c.dataset.key!); } catch (e) {}
    }));

    // Route map
    try {
      const map = L.map('route-map', { scrollWheelZoom: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);
      // One pin per place, numbered in route order; the dashed line follows the same order as the Google Maps link.
      const pts = places.map((p) => [p.lat, p.lng] as [number, number]);
      L.polyline(pts, { color: '#C89B3C', weight: 4, dashArray: '6 8' }).addTo(map);
      const stopName = (id: string) => t.stops.find((s) => s.id === id)?.name ?? '';
      places.forEach((p, i) => L.circleMarker([p.lat, p.lng], { radius: 8, color: '#fff', weight: 2, fillColor: '#1B4332', fillOpacity: 1 })
        .addTo(map).bindTooltip(`${i + 1}. ${p.name}${p.slug ? ` (near ${stopName(p.stopId)})` : ''}`, { permanent: false }));
      const bounds = L.latLngBounds(pts).pad(0.3);
      map.fitBounds(bounds);
      // The map may be drawn while its panel is hidden (size 0); redraw once it has a real size.
      new ResizeObserver(() => { map.invalidateSize(); map.fitBounds(bounds); }).observe($('route-map'));
    } catch (e) { $('route-map').textContent = 'Map unavailable offline.'; }
  }

  function setupTabs() {
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { select((i + 1) % tabs.length); tabs[(i + 1) % tabs.length].focus(); }
        if (e.key === 'ArrowLeft') { select((i - 1 + tabs.length) % tabs.length); tabs[(i - 1 + tabs.length) % tabs.length].focus(); }
      });
    });
    function select(i: number) {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = i !== j;
      });
    }
    select(0);
  }
</script>
