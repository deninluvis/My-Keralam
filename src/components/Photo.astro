---
// A content photo with the credit its licence asks for. `photo` is one entry from an `images` list.
// Inside a card that is itself a link, pass link={false}: a link inside a link breaks the page.
interface Props { photo: { url: string; credit: string; license: string; source?: string }; alt: string; class?: string; link?: boolean }
const { photo, alt, class: cls = '', link = true } = Astro.props;
---
<figure class={`photo ${cls}`}>
  <img src={photo.url} alt={alt} loading="lazy" decoding="async" />
  <figcaption>Photo: {photo.credit} · {link && photo.source ? <a href={photo.source} rel="noopener">{photo.license}</a> : photo.license}</figcaption>
</figure>
