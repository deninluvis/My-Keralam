---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url.js';
import { all } from '../lib/content.js';
const its = await all('itineraries');
---
<Base title="Itineraries" description="Ready-made Kerala itineraries: 7, 10 and 14 days, plus a wellness trip.">
  <PageHead eyebrow="Plan" title="Ready-made itineraries" lead="Tried-and-tested routes. Open any of them in the planner to set your own dates and get a budget, visa notes and packing list." />
  <div class="wrap its">
    {its.map((it) => (
      <section class="card it" id={it.slug}>
        <h2>{it.name}</h2>
        <p class="muted">{it.who}</p>
        <ol class="tl">{it.days.map(({ d, place, what }) => <li><span class="d">Day {d}</span><div><strong>{place}</strong><p class="small">{what}</p></div></li>)}</ol>
        <a class="btn small open-plan" href={`${url('/my-trip')}?${it.q}`} data-q={it.q}>Open in planner <Icon name="arrow" /></a>
      </section>
    ))}
    <p class="small muted">Driving times: Kochi–Munnar about 4 h; Munnar–Thekkady about 3.5 h; Thekkady–Alappuzha about 4 h. See <a href={url('/getting-around')}>getting around</a>.</p>
  </div>
</Base>
<style>
  .its { display: grid; gap: 16px; }
  .it { scroll-margin-top: 80px; } .it h2 { margin-top: 0; }
  .tl { list-style: none; padding: 0; margin: 0 0 16px; border-left: 3px solid var(--line); }
  .tl li { display: grid; grid-template-columns: 90px 1fr; gap: 8px; padding: 6px 0 6px 14px; position: relative; }
  .tl li::before { content: ''; position: absolute; left: -8px; top: 12px; width: 12px; height: 12px; border-radius: 50%; background: var(--green); border: 2px solid var(--surface); }
  .tl .d { font-weight: 600; color: var(--muted); font-size: .9rem; }
  .tl p { margin: 0; }
</style>
<script>
  // Start the trip 60 days from today unless a plan already exists.
  document.querySelectorAll<HTMLAnchorElement>('.open-plan').forEach((a) => a.addEventListener('click', () => {
    const start = new Date(Date.now() + 60 * 864e5).toISOString().slice(0, 10);
    a.href = `${a.href.split('?')[0]}?${a.dataset.q}&start=${start}&budget=mid&people=2`;
  }));
</script>
