---
import ImportedSection from '../components/ImportedSection.astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url.js';
import { all } from '../lib/content.js';
const items = await all('experiences');
const href = (h: string) => (h.startsWith('http') ? h : url(h));
---
<Base title="Experiences" description="Top Kerala experiences: houseboats, Ayurveda, Kathakali and Theyyam, plantations, village life, wildlife and adventure.">
  <PageHead eyebrow="Explore" title="Experiences" lead="The things that make a Kerala trip memorable, with practical tips for each.">
    <div class="toc">{items.map((i) => <a class="chip" href={`#${i.slug}`}>{i.name.split(' &')[0]}</a>)}</div>
  </PageHead>
  <div class="wrap exp-list">
    {items.map((i) => (
      <section class="card exp" id={i.slug}>
        <span class="exp-icon"><Icon name={i.icon} /></span>
        <div>
          <h2>{i.name}</h2>
          <p>{i.text}</p>
          <ul class="small">{i.tips.map((t) => <li>{t}</li>)}</ul>
          <a href={href(i.link.href)} rel={i.link.href.startsWith('http') ? 'noopener' : undefined}>{i.link.label} →</a>
        </div>
      </section>
    ))}
    <ImportedSection type="experience" />
  </div>
</Base>
<style>
  .exp-list { display: grid; gap: 16px; }
  .exp { display: grid; gap: 16px; scroll-margin-top: 80px; }
  @media (min-width: 700px) { .exp { grid-template-columns: 64px 1fr; } }
  .exp h2 { margin-top: 0; }
  .exp-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 14px; background: var(--ok-soft); color: var(--green); }
  .exp-icon :global(svg) { width: 30px; height: 30px; }
</style>
