---
// My Trip merged into Plan My Trip. Old shared links (/my-trip?...) forward there with the same trip.
import { url } from '../lib/url.js';
const target = url('/plan');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <title>Moved to Plan My Trip</title>
  <script is:inline define:vars={{ target }}>location.replace(target + location.search);</script>
</head>
<body>
  <p>My Trip is now part of <a href={target}>Plan My Trip</a>.</p>
</body>
</html>
